# Copy this file to .env in the repo root (next to docker-compose.yml).
# docker compose reads it to create the local Postgres database.
# These are local-development values only; they are safe to commit. Never put real secrets here.
POSTGRES_DB=bnto
POSTGRES_USER=bnto_user
POSTGRES_PASSWORD=bnto_pass

# The backend does NOT read this file. Set JWT_SECRET as an environment variable in the
# terminal that runs the backend instead. See "Run the backend locally" in README.md.
